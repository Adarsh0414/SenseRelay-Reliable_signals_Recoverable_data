# Device / pipeline configuration
PIPELINE_DB_PATH=./data/device.db
MOCK_HOST=127.0.0.1
MOCK_PORT=7100
CLOUD_URL=http://127.0.0.1:8000
CLOUD_API_TOKEN=change-this-demo-token
POLL_INTERVAL_SECONDS=0.05
HEALTH_INTERVAL_SECONDS=1.0
HTTP_CONNECT_TIMEOUT_SECONDS=0.7
HTTP_READ_TIMEOUT_SECONDS=2.0
UPLOAD_LIVE_LIMIT=8000
UPLOAD_BACKLOG_LIMIT=4000

# Cloud service configuration
APP_ENV=development
# API docs are enabled in development and disabled by default when APP_ENV=production.
# Set ENABLE_API_DOCS=true only if the public API reference is intentionally exposed.
# ENABLE_API_DOCS=false
CLOUD_DB_PATH=./data/cloud.db
CLOUD_BIND=127.0.0.1
CLOUD_PORT=8000

# Optional dashboard authentication for remote deployments.
# Do not leave partial values configured; all three are required together.
# DASHBOARD_USERNAME=admin
# DASHBOARD_PASSWORD=replace-with-a-unique-password-at-least-12-characters
# DASHBOARD_SESSION_SECRET=generate-a-random-secret-at-least-32-characters
# DASHBOARD_COOKIE_SECURE=true
# Public portfolio demo only: GET dashboard routes are public; write actions remain blocked.
# Requires ENABLE_SYNTHETIC_DEMO_SEED=true. Keep all exposed data synthetic.
# DASHBOARD_PUBLIC_READ_ONLY=false
# DASHBOARD_DEVICE_DB_PATH=./data/device.db
# Separate store for administrator-imported datasets; never point this at the demo databases.
# ADMIN_DB_PATH=./data/admin.db

# Dashboard-only presentation fixture. Enabled by default only in development/test environments.
# The generator writes a deterministic synthetic JSONL source and stores the same
# samples/results in device/cloud SQLite. Do not enable for public production unless reviewed.
# ENABLE_SYNTHETIC_DEMO_SEED=true
# DEMO_DATASET_PATH=./data/synthetic_demo_dataset.jsonl
