[Unit]
Description=MayaCardio synthetic biosignal pipeline
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mayacardio
Group=mayacardio
WorkingDirectory=/opt/mayacardio
EnvironmentFile=/etc/mayacardio-pipeline.env
ExecStart=/opt/mayacardio/.venv/bin/pipeline run
Restart=always
RestartSec=1
KillSignal=SIGTERM
TimeoutStopSec=10
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/mayacardio /opt/mayacardio/data

[Install]
WantedBy=multi-user.target
