# Build the React dashboard, then serve it from the existing FastAPI application.
# This is intentionally separate from the root Dockerfile, which runs the device pipeline CLI.

FROM node:22-bookworm-slim AS frontend-build
WORKDIR /build/frontend
COPY frontend/package*.json ./
RUN npm install --no-audit --no-fund
COPY frontend/ ./
ARG PUBLIC_SITE_URL=""
ENV PUBLIC_SITE_URL=${PUBLIC_SITE_URL}
RUN npm run build

FROM python:3.12-slim AS web-runtime
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    APP_ENV=production \
    ENABLE_API_DOCS=false
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml requirements.txt ./
COPY pipeline ./pipeline
RUN pip install --no-cache-dir .
COPY data/fixtures ./data/fixtures
COPY --from=frontend-build /build/frontend/dist ./frontend/dist
EXPOSE 10000
CMD ["sh", "-c", "exec uvicorn pipeline.cloud_app:app --host 0.0.0.0 --port ${PORT:-10000}"]
